{
    "name": "svelte-markdoc-preprocess",
    "version": "3.0.4",
    "description": "A Svelte preprocessor that allows you to use Markdoc.",
    "type": "module",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "svelte",
        "preprocessor",
        "markdoc",
        "markdown",
        "md"
    ],
    "scripts": {
        "test": "node --test",
        "check": "publint && tsc --noEmit",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "dev": "tsc --watch",
        "build": "tsc"
    },
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "import": "./dist/module.js",
            "require": "./dist/module.js"
        }
    },
    "author": "Torsten Dittmann",
    "license": "MIT",
    "dependencies": {
        "@markdoc/markdoc": "^0.5.9",
        "estree-walker": "^3.0.3",
        "html-escaper": "^3.0.3",
        "yaml": "^2.9.0",
        "lovely-logs": "^2.7.2",
        "svelte": "^5.56.10"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TorstenDittmann/svelte-markdoc-preprocess.git"
    },
    "homepage": "https://svelte-markdoc-preprocess.pages.dev",
    "devDependencies": {
        "@types/html-escaper": "^3.0.4",
        "@types/node": "^22.20.1",
        "fast-glob": "^3.3.3",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "typescript": "^5.9.3"
    }
}
